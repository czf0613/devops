# Copy to deploy.env and fill the real values; deploy.env is git-ignored.
# scripts/deploy.py uploads it as /dockerdata/devops/deploy/.env.deploy.
# Connection settings only; runtime configuration lives in PostgreSQL.

# PostgreSQL: Aliyun RDS (internal/VPC endpoint).
POSTGRES_HOST=pgm-xxxxxxxxxxxxxxxx.pg.rds.aliyuncs.com
POSTGRES_PORT=5432
POSTGRES_DB=devops
POSTGRES_USER=devops
POSTGRES_PASSWORD=

# Redis: Aliyun Tair (Redis 7.0 compatible), DB 0 only.
REDIS_HOST=r-xxxxxxxxxxxxxxxx.redis.rds.aliyuncs.com
# Redis logical database (0-15). Other projects may use the remaining DBs.
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=false

# Mail. SMTP_SSL: none | starttls | ssl (ssl = implicit TLS, usually port 465).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SSL=ssl
SMTP_USER=service@example.com
SMTP_PASSWORD=
SMTP_FROM=DevOps <service@example.com>
